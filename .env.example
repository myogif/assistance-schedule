# Database Configuration
DB_DIALECT=sqlite
DB_STORAGE=./data/assistance.sqlite
# Optional for Postgres / MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=assistance_schedule
# DB_USER=postgres
# DB_PASSWORD=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Comma-separated group IDs or @usernames allowed to use bot (leave empty = allow all groups)
TELEGRAM_ALLOWED_GROUPS=
ACTIVE_NICHE=finance

# Invezgo Blog Auto-Broadcast
TELEGRAM_NEWS_GROUP_ID=   # ID grup/channel tujuan, contoh: -1001234567890
# Broadcast Scheduler Mode: 'slot' (disarankan untuk jadwal reguler: 08:00, 10:00, 12:00, 14:00, 17:00) atau 'instant'
BROADCAST_MODE=slot
# Pada mode slot, apakah langsung memproses 1 artikel saat bot pertama kali dijalankan? (true/false)
BROADCAST_PROCESS_ON_START=true
INVEZGO_CHECK_INTERVAL_MS=1800000   # Interval cek artikel baru (default: 30 menit)
BROADCAST_SCHEDULE_HOURS=8,10,12,14,17   # Jam pengiriman pada mode slot (format 24h, WIB/lokal server)
# Proteksi Cold-Start & Safety Throttle:
# BROADCAST_CATCHUP=false            # Set true jika sengaja ingin memproses semua artikel lama saat database kosong
# BROADCAST_INSTANT_DELAY_MS=5000    # Jeda aman (ms) antar pemrosesan artikel pada mode instant (default: 5000)
# BROADCAST_MAX_PER_POLL=1           # Batas maksimal artikel per siklus polling pada mode instant (0 = tanpa batas)
# Post Format: 'single' (default: 1 gambar editorial) atau 'carousel' (multi-slide storytelling)
POST_FORMAT=single
# BROADCAST_POST_FORMAT=single       # Format khusus scheduler: 'single' atau 'carousel'
# CAROUSEL_SLIDE_COUNT=4             # Target jumlah slide per carousel (default: 4, min: 2, max: 7)
# OpenAI Configuration
OPENAI_API_KEY=
TEXT_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o
IMAGE_MODEL=gpt-image-2.5-sunburst
VISION_MODEL=gpt-4o
IMAGE_QUALITY=standard
IMAGE_SIZE=1088x1360

# Local Image API (Optional Gemini endpoint)
LOCAL_IMAGE_API_URL=http://localhost:20128/v1/images/generations
LOCAL_IMAGE_API_KEY=sk-5e835ab2c467c876-dovups-b2f50d68
LOCAL_IMAGE_MODEL=ag/gemini-3.1-flash-image

# Zernio Instagram Publishing
ZERNIO_API_KEY=
# ZERNIO_INSTAGRAM_ACCOUNT_ID=  # Optional: auto-fetched from API if omitted

# Scraper Configuration
PLAYWRIGHT_HEADLESS=true
SCRAPE_MAX_RETRIES=2
DEBUG_SCRAPER=false

# Server Configuration
PORT=4000
CORS_ORIGIN=*
